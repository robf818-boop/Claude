# Alpaca API Keys
# Get these from https://app.alpaca.markets/

# For Paper Trading (testing)
ALPACA_KEY=your_paper_api_key_here
ALPACA_SECRET=your_paper_secret_key_here
ALPACA_PAPER=true

# For Live Trading (real money) - USE WITH CAUTION
# ALPACA_KEY=your_live_api_key_here
# ALPACA_SECRET=your_live_secret_key_here
# ALPACA_PAPER=false
