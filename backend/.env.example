# Alpaca API Credentials
# Get these from: https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=your_api_key_here
ALPACA_API_SECRET=your_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets  # Paper trading URL

# Trading Parameters
STARTING_CAPITAL=100000.00
MAX_POSITION_SIZE_PCT=0.10  # 10% per trade
STOP_LOSS_PCT=0.03  # 3%
TAKE_PROFIT_PCT=0.05  # 5%
MAX_DAILY_DRAWDOWN_PCT=0.03  # 3% circuit breaker
MAX_WEEKLY_DRAWDOWN_PCT=0.07  # 7% circuit breaker
MAX_OPEN_POSITIONS=10

# Market Data (optional - Alpaca includes free data)
POLYGON_API_KEY=optional_polygon_key
