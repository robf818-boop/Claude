# ── Alpaca credentials ──────────────────────────────────────────────────────
ALPACA_KEY=your_live_key_here
ALPACA_SECRET=your_live_secret_here

# ── Mode ─────────────────────────────────────────────────────────────────────
# PAPER=true  → paper trading endpoint
# PAPER=false → live trading (requires LIVE_ARMED=true)
PAPER=false
LIVE_ARMED=true
DRY_RUN=false          # true = log orders but never submit

# ── Loop ─────────────────────────────────────────────────────────────────────
LOOP_SECONDS=300       # run cycle every 5 minutes

# ── Symbols ──────────────────────────────────────────────────────────────────
# ETFs held long when above SMA200
TREND_SYMBOLS=SPY,QQQ

# Stocks the wheel runs on (must be optionable with good liquidity)
WHEEL_SYMBOLS=AAPL,MSFT,NVDA,AMZN,META,AMD,GOOGL,TSLA

# ── Wheel parameters ─────────────────────────────────────────────────────────
MAX_WHEEL_POSITIONS=6  # concurrent wheel positions
MAX_CAPITAL_PCT=0.60   # max % of portfolio deployed in wheels

PUT_OTM_PCT=0.04       # sell put 4% below current price
CALL_OTM_PCT=0.03      # sell call 3% above cost basis

DTE_MIN=30             # minimum days to expiration
DTE_MAX=45             # maximum days to expiration

PROFIT_CLOSE=0.50      # buy back option when 50% of premium is captured
STOP_MULT=2.00         # close if option is worth 2x what we sold it for (100% loss)

# ── Risk controls ─────────────────────────────────────────────────────────────
HV_PANIC=0.45          # halt new wheels if 20-day HV of SPY exceeds 45% annualized
WEEKLY_HALT_PCT=0.05   # halt all new trades if weekly P&L drops below -5%

# ── Paths ─────────────────────────────────────────────────────────────────────
LOG_DIR=./bot_data
